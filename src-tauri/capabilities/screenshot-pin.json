{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screenshot-pin-capability",
  "description": "Capability for pinned screenshot windows (always-on-top stickies)",
  "windows": ["screenshot-pin-*"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-scale-factor"
  ]
}
