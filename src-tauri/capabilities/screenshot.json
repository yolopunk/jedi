{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screenshot-capability",
  "description": "Capability for screenshot overlay windows (region selection) and the floating capture toolbar",
  "windows": [
    "screenshot-overlay-*",
    "screenshot-toolbar"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-scale-factor",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
