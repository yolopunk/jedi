{
  "productName": "Jedi",
  "version": "0.2.3",
  "identifier": "io.jedi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:31420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "decorations": true,
        "resizable": true,
        "title": "Jedi",
        "width": 980,
        "height": 600,
        "minWidth": 980,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/yolopunk/jedi/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMjE1RDlCREI5RkJGQ0IKUldUTHY1L2JtMTBoMGE2TUNOak9Eb2kyWkcySlBmS3ZWbDNtK3RlREwveGdIRW1rbDdMcTE0aEIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}